<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BasePawn" Name="RimRunnerDummyBase" Abstract="True">
    <label>test dummy</label>
    <description>A neutral target used by automated regression tests.</description>
    <race>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>RimRunnerDummy_Main</thinkTreeMain>
      <thinkTreeConstant>RimRunnerDummy_Constant</thinkTreeConstant>
      <foodType>None</foodType>
      <needsRest>false</needsRest>
      <hasGenders>false</hasGenders>
      <baseBodySize>1</baseBodySize>
      <baseHealthScale>1</baseHealthScale>
      <hideTrainingTab>true</hideTrainingTab>
      <trainability>None</trainability>
      <disableIgniteVerb>true</disableIgniteVerb>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>strike</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <comps>
      <li Class="RimRunner.RimRunnerDummyCompProperties">
        <thinkTree>RimRunnerDummy_Wait</thinkTree>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RimRunnerDummyBase">
    <defName>RimRunnerDummy</defName>
    <race>
      <body>RimRunnerDummy_Body</body>
    </race>
  </ThingDef>

  <ThingDef ParentName="RimRunnerDummyBase">
    <defName>RimRunnerDummyBare</defName>
    <label>test dummy (bare)</label>
    <race>
      <body>RimRunnerDummyBare_Body</body>
      <doesntMove>true</doesntMove>
    </race>
  </ThingDef>

  <ThingDef ParentName="RimRunnerDummyBase">
    <defName>RimRunnerDummyHumanBody</defName>
    <label>test dummy (human body)</label>
    <race>
      <body>Human</body>
    </race>
  </ThingDef>

</Defs>
