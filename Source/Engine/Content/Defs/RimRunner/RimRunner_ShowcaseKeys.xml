<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <KeyBindingCategoryDef>
    <defName>RimRunner_Showcase</defName>
    <label>RimRunner 展台</label>
    <description>RimRunner 展台面板开着时生效的按键。</description>
  </KeyBindingCategoryDef>

  <KeyBindingDef>
    <defName>RimRunner_ShowcaseNextStep</defName>
    <label>展台：下一步</label>
    <category>RimRunner_Showcase</category>
    <defaultKeyCodeA>Backslash</defaultKeyCodeA>
    <devModeOnly>true</devModeOnly>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>RimRunner_ShowcaseCycleNext</defName>
    <label>展台：换一支候选</label>
    <category>RimRunner_Showcase</category>
    <defaultKeyCodeA>Tab</defaultKeyCodeA>
    <devModeOnly>true</devModeOnly>
  </KeyBindingDef>

</Defs>
