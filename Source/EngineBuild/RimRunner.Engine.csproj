<Project>
  <Import Project="..\..\RimTooling\Sources\RimTooling.ModBuild\Sdk\Sdk.props" />
    <PropertyGroup>
        <AssemblyName>RimRunner</AssemblyName>
        <RootNamespace>RimRunner</RootNamespace>
        <Nullable>enable</Nullable>
        <WarningLevel>4</WarningLevel>
        <Deterministic>true</Deterministic>

        <OutputPath>bin\</OutputPath>
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
        <ProduceReferenceAssemblyInOutDir>true</ProduceReferenceAssemblyInOutDir>

        <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
        <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735</WarningsAsErrors>

        <UseHarmony>true</UseHarmony>
        <Configurations>Release</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>
    <ItemGroup>
        <RimWorldReference Include="Waylith;Waylith.Windowing;Brutal.Stb;Brutal.Core.Logging;Microsoft.Extensions.Logging.Abstractions"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Engine\**\*.cs">
            <Link>Engine\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>
    </ItemGroup>
  <Import Project="..\..\RimTooling\Sources\RimTooling.ModBuild\Sdk\Sdk.targets" />
</Project>
